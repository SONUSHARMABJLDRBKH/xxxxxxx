rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token &&
         request.auth.token.email == 'farginagabhai@gmail.com' &&
         'email_verified' in request.auth.token &&
         request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 600)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 24)) &&
             (!('phoneVerified' in data) || data.phoneVerified is bool) &&
             data.language in ['en', 'hi'] &&
             (!('darkMode' in data) || data.darkMode is bool) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             data.role in ['user', 'admin'] &&
             data.blocked is bool &&
             (!('blockReason' in data) || (data.blockReason is string && data.blockReason.size() <= 300)) &&
             data.welcomeBonusClaimed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWallet(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.availableCoins is int && data.availableCoins >= 0 && data.availableCoins <= 100000000 &&
             data.totalEarnedCoins is int && data.totalEarnedCoins >= 0 && data.totalEarnedCoins <= 100000000 &&
             (!('welcomeBonusCoins' in data) || (data.welcomeBonusCoins is int && data.welcomeBonusCoins >= 0 && data.welcomeBonusCoins <= 1000)) &&
             (!('dailyBonusCoins' in data) || (data.dailyBonusCoins is int && data.dailyBonusCoins >= 0)) &&
             (!('scratchCoins' in data) || (data.scratchCoins is int && data.scratchCoins >= 0)) &&
             (!('spinCoins' in data) || (data.spinCoins is int && data.spinCoins >= 0)) &&
             (!('quizCoins' in data) || (data.quizCoins is int && data.quizCoins >= 0)) &&
             (!('adCoins' in data) || (data.adCoins is int && data.adCoins >= 0)) &&
             (!('redeemedCoins' in data) || (data.redeemedCoins is int && data.redeemedCoins >= 0)) &&
             (!('adRewardsCount' in data) || (data.adRewardsCount is int && data.adRewardsCount >= 0)) &&
             (!('specialSpinsUnlocked' in data) || (data.specialSpinsUnlocked is int && data.specialSpinsUnlocked >= 0)) &&
             (!('specialSpinsUsed' in data) || (data.specialSpinsUsed is int && data.specialSpinsUsed >= 0)) &&
             (!('lastDailyBonusAt' in data) || (data.lastDailyBonusAt is int && data.lastDailyBonusAt >= 0)) &&
             (!('dailyScratchDate' in data) || (data.dailyScratchDate is string && data.dailyScratchDate.size() <= 32)) &&
             (!('dailyScratchUsed' in data) || (data.dailyScratchUsed is int && data.dailyScratchUsed >= 0 && data.dailyScratchUsed <= 100)) &&
             (!('extraScratchAvailable' in data) || (data.extraScratchAvailable is int && data.extraScratchAvailable >= 0 && data.extraScratchAvailable <= 50)) &&
             (!('lastFreeSpinAt' in data) || (data.lastFreeSpinAt is int && data.lastFreeSpinAt >= 0)) &&
             (!('adFreePassExpiresAt' in data) || (data.adFreePassExpiresAt is int && data.adFreePassExpiresAt >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.txType is string && data.txType.size() >= 2 && data.txType.size() <= 40 &&
             data.amount is int && data.amount >= -1000000 && data.amount <= 1000000 &&
             data.status in ['COMPLETED', 'PENDING', 'REJECTED'] &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 240 &&
             (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidDailyBonus(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.claimDate is string && data.claimDate.size() >= 4 && data.claimDate.size() <= 32 &&
             data.coins is int && data.coins >= 1 && data.coins <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidScratchCard(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.cardDate is string && data.cardDate.size() >= 4 && data.cardDate.size() <= 32 &&
             data.coins is int && data.coins >= 1 && data.coins <= 500 &&
             data.extraAdCard is bool &&
             data.claimed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSpinHistory(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.coins is int && data.coins >= 1 && data.coins <= 999 &&
             data.spinType in ['DAILY_FREE', 'AD_EXTRA', 'SPECIAL_999'] &&
             data.adVerified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidQuizQuestion(data) {
      return data.questionClass is int && data.questionClass >= 9 && data.questionClass <= 12 &&
             data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 40 &&
             data.chapter is string && data.chapter.size() >= 1 && data.chapter.size() <= 120 &&
             data.questionText is string && data.questionText.size() >= 4 && data.questionText.size() <= 800 &&
             data.optionA is string && data.optionA.size() >= 1 && data.optionA.size() <= 300 &&
             data.optionB is string && data.optionB.size() >= 1 && data.optionB.size() <= 300 &&
             data.optionC is string && data.optionC.size() >= 1 && data.optionC.size() <= 300 &&
             data.optionD is string && data.optionD.size() >= 1 && data.optionD.size() <= 300 &&
             data.correctOption in ['A', 'B', 'C', 'D'] &&
             data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 1000 &&
             data.source is string && data.source.size() >= 1 && data.source.size() <= 200 &&
             (!('examYear' in data) || (data.examYear is string && data.examYear.size() <= 20)) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuizAttempt(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 128 &&
             data.questionClass is int && data.questionClass >= 9 && data.questionClass <= 12 &&
             data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 40 &&
             data.selectedOption in ['A', 'B', 'C', 'D'] &&
             data.correct is bool &&
             data.coinsAwarded is int && data.coinsAwarded >= 0 && data.coinsAwarded <= 5 &&
             data.pointsAwarded is number && data.pointsAwarded >= 0.0 && data.pointsAwarded <= 1.0 &&
             (!('adsWatchedForUnlock' in data) || (data.adsWatchedForUnlock is int && data.adsWatchedForUnlock >= 0 && data.adsWatchedForUnlock <= 3)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidQuizScore(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('mathScore' in data) || (data.mathScore is number && data.mathScore >= 0.0)) &&
             (!('physicsScore' in data) || (data.physicsScore is number && data.physicsScore >= 0.0)) &&
             (!('chemistryScore' in data) || (data.chemistryScore is number && data.chemistryScore >= 0.0)) &&
             (!('biologyScore' in data) || (data.biologyScore is number && data.biologyScore >= 0.0)) &&
             (!('hindiScore' in data) || (data.hindiScore is number && data.hindiScore >= 0.0)) &&
             (!('englishScore' in data) || (data.englishScore is number && data.englishScore >= 0.0)) &&
             data.totalAttempted is int && data.totalAttempted >= 0 &&
             data.correctCount is int && data.correctCount >= 0 &&
             data.incorrectCount is int && data.incorrectCount >= 0 &&
             data.overallScore is number && data.overallScore >= 0.0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdReward(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.adFormat is string && data.adFormat.size() >= 2 && data.adFormat.size() <= 40 &&
             data.placement is string && data.placement.size() >= 2 && data.placement.size() <= 60 &&
             data.adUnitId is string && data.adUnitId.size() >= 10 && data.adUnitId.size() <= 100 &&
             data.coinsAwarded is int && data.coinsAwarded >= 0 && data.coinsAwarded <= 1000 &&
             data.verified is bool &&
             data.rewardToken is string && data.rewardToken.size() >= 4 && data.rewardToken.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAdFreePass(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.costCoins is int && data.costCoins == 6999 &&
             data.durationHours is int && data.durationHours == 24 &&
             data.active is bool &&
             data.expiresAt is int && data.expiresAt > 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRewardItem(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
             (!('titleHi' in data) || (data.titleHi is string && data.titleHi.size() <= 120)) &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
             data.coinCost is int && data.coinCost >= 0 && data.coinCost <= 10000000 &&
             data.inventoryCount is int && data.inventoryCount >= 0 && data.inventoryCount <= 100000 &&
             data.deliveryTerms is string && data.deliveryTerms.size() >= 2 && data.deliveryTerms.size() <= 500 &&
             data.imageKey is string && data.imageKey.size() >= 2 && data.imageKey.size() <= 80 &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRewardSubmission(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 80 &&
             data.rewardId is string && data.rewardId.size() >= 1 && data.rewardId.size() <= 128 &&
             data.rewardTitle is string && data.rewardTitle.size() >= 2 && data.rewardTitle.size() <= 120 &&
             data.submissionType in ['STORE_REDEMPTION', 'MONTHLY_PARTICIPATION'] &&
             data.coinCost is int && data.coinCost >= 0 && data.coinCost <= 10000000 &&
             (!('upiOrAddress' in data) || (data.upiOrAddress is string && data.upiOrAddress.size() <= 300)) &&
             (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 100)) &&
             (!('screenshotName' in data) || (data.screenshotName is string && data.screenshotName.size() <= 200)) &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'FULFILLED'] &&
             (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             (!('titleHi' in data) || (data.titleHi is string && data.titleHi.size() <= 150)) &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 1000 &&
             (!('messageHi' in data) || (data.messageHi is string && data.messageHi.size() <= 1000)) &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
             (!('winnerNames' in data) || (data.winnerNames is string && data.winnerNames.size() <= 300)) &&
             (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 300)) &&
             (!('closingDate' in data) || (data.closingDate is string && data.closingDate.size() <= 40)) &&
             (!('resultDate' in data) || (data.resultDate is string && data.resultDate.size() <= 40)) &&
             (!('availableSlots' in data) || (data.availableSlots is int && data.availableSlots >= 0)) &&
             (!('participantCount' in data) || (data.participantCount is int && data.participantCount >= 0)) &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             (!('titleHi' in data) || (data.titleHi is string && data.titleHi.size() <= 150)) &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
             (!('bodyHi' in data) || (data.bodyHi is string && data.bodyHi.size() <= 500)) &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
             data.readFlag is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 80 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 600)) &&
             data.totalQuizScore is number && data.totalQuizScore >= 0.0 &&
             data.totalCoinsEarned is int && data.totalCoinsEarned >= 0 &&
             data.weeklyScore is number && data.weeklyScore >= 0.0 &&
             data.monthlyScore is number && data.monthlyScore >= 0.0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAppSettings(data) {
      return data.adMobAppId is string && data.adMobAppId.size() >= 10 && data.adMobAppId.size() <= 100 &&
             data.bannerAdUnitId is string && data.bannerAdUnitId.size() >= 10 && data.bannerAdUnitId.size() <= 100 &&
             data.rewardedAdUnitId is string && data.rewardedAdUnitId.size() >= 10 && data.rewardedAdUnitId.size() <= 100 &&
             (!('interstitialAdUnitId' in data) || (data.interstitialAdUnitId is string && data.interstitialAdUnitId.size() <= 100)) &&
             data.useTestAds is bool &&
             data.instagramUrl is string && data.instagramUrl.size() <= 300 &&
             (!('dailyBonusMin' in data) || (data.dailyBonusMin is int && data.dailyBonusMin >= 1)) &&
             (!('dailyBonusMax' in data) || (data.dailyBonusMax is int && data.dailyBonusMax <= 500)) &&
             (!('scratchMin' in data) || (data.scratchMin is int && data.scratchMin >= 1)) &&
             (!('scratchMax' in data) || (data.scratchMax is int && data.scratchMax <= 500)) &&
             (!('spinWeightsCsv' in data) || (data.spinWeightsCsv is string && data.spinWeightsCsv.size() <= 200)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 1. users (PII isolated to owner or admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().role == 'user' &&
                       incoming().blocked == false &&
                       incoming().keys().hasAll(['userId', 'displayName', 'language', 'role', 'blocked', 'welcomeBonusClaimed', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isValidUserProfile(incoming()) && (
                       isAdmin() || (
                         isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().role == existing().role &&
                         incoming().blocked == existing().blocked &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'phoneNumber', 'phoneVerified', 'language', 'darkMode', 'notificationsEnabled', 'welcomeBonusClaimed', 'updatedAt'])
                       )
                     );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 2. wallets
    match /wallets/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().availableCoins <= 10 &&
                       incoming().totalEarnedCoins <= 10 &&
                       incoming().keys().hasAll(['userId', 'availableCoins', 'totalEarnedCoins', 'createdAt', 'updatedAt']) &&
                       isValidWallet(incoming());
      allow update: if isValidId(userId) && isValidWallet(incoming()) && (
                       isAdmin() || (
                         isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'availableCoins', 'totalEarnedCoins', 'welcomeBonusCoins', 'dailyBonusCoins',
                           'scratchCoins', 'spinCoins', 'quizCoins', 'adCoins', 'redeemedCoins',
                           'adRewardsCount', 'specialSpinsUnlocked', 'specialSpinsUsed',
                           'lastDailyBonusAt', 'dailyScratchDate', 'dailyScratchUsed',
                           'extraScratchAvailable', 'lastFreeSpinAt', 'adFreePassExpiresAt', 'updatedAt'
                         ])
                       )
                     );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 3. transactions (immutable append-only for user; admin can update status)
    match /transactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(txId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidTransaction(incoming());
      allow update: if isValidId(txId) && isAdmin() && isValidTransaction(incoming());
      allow delete: if isValidId(txId) && (isOwner(existing().userId) || isAdmin());
    }

    // 4. daily_bonuses
    match /daily_bonuses/{bonusId} {
      allow get: if isValidId(bonusId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(bonusId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidDailyBonus(incoming());
      allow delete: if isValidId(bonusId) && (isOwner(existing().userId) || isAdmin());
    }

    // 5. scratch_cards
    match /scratch_cards/{cardId} {
      allow get: if isValidId(cardId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(cardId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidScratchCard(incoming());
      allow delete: if isValidId(cardId) && (isOwner(existing().userId) || isAdmin());
    }

    // 6. spin_history
    match /spin_history/{spinId} {
      allow get: if isValidId(spinId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(spinId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidSpinHistory(incoming());
      allow delete: if isValidId(spinId) && (isOwner(existing().userId) || isAdmin());
    }

    // 7. quiz_questions (non-PII catalog; signed-in read, admin write)
    match /quiz_questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(questionId) && isAdmin() && isValidQuizQuestion(incoming());
      allow update: if isValidId(questionId) && isAdmin() && isValidQuizQuestion(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(questionId) && isAdmin();
    }

    // 8. quiz_attempts
    match /quiz_attempts/{attemptId} {
      allow get: if isValidId(attemptId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(attemptId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidQuizAttempt(incoming());
      allow delete: if isValidId(attemptId) && (isOwner(existing().userId) || isAdmin());
    }

    // 9. quiz_scores
    match /quiz_scores/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       isValidQuizScore(incoming());
      allow update: if isValidId(userId) && isValidQuizScore(incoming()) && (
                       isAdmin() || (
                         isOwner(userId) &&
                         incoming().userId == existing().userId
                       )
                     );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 10. ad_rewards (immutable once logged)
    match /ad_rewards/{rewardEventId} {
      allow get: if isValidId(rewardEventId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(rewardEventId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidAdReward(incoming());
      allow delete: if isValidId(rewardEventId) && (isOwner(existing().userId) || isAdmin());
    }

    // 11. ad_free_passes
    match /ad_free_passes/{passId} {
      allow get: if isValidId(passId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(passId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidAdFreePass(incoming());
      allow delete: if isValidId(passId) && (isOwner(existing().userId) || isAdmin());
    }

    // 12. rewards (catalog)
    match /rewards/{rewardId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(rewardId) && isAdmin() && isValidRewardItem(incoming());
      allow update: if isValidId(rewardId) && isAdmin() && isValidRewardItem(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(rewardId) && isAdmin();
    }

    // 13. reward_submissions (terminal status locking, admin approves/rejects)
    match /reward_submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(submissionId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       isValidRewardSubmission(incoming());
      allow update: if isValidId(submissionId) && isAdmin() && isValidRewardSubmission(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(submissionId) && (isOwner(existing().userId) || isAdmin());
    }

    // 14. announcements
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming());
      allow update: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    // 15. notifications (user-targeted or broadcast 'ALL')
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || existing().userId == 'ALL' || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || existing().userId == 'ALL' || isAdmin());
      allow create: if isValidId(notificationId) && isSignedIn() && (
                       isAdmin() || (incoming().userId == request.auth.uid && isValidNotification(incoming()))
                     );
      allow update: if isValidId(notificationId) && isSignedIn() && isValidNotification(incoming()) && (
                       isAdmin() || (
                         existing().userId == request.auth.uid &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['readFlag'])
                       )
                     );
      allow delete: if isValidId(notificationId) && (isOwner(existing().userId) || isAdmin());
    }

    // 16. admin_users
    match /admin_users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(uid) && isAdmin();
    }

    // 17. leaderboard (non-PII public rankings)
    match /leaderboard/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(userId) && isValidLeaderboardEntry(incoming()) && (
                               isAdmin() || (isOwner(userId) && incoming().userId == request.auth.uid)
                             );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 18. app_config
    match /app_config/{configId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isValidId(configId) && isAdmin() && isValidAppSettings(incoming());
    }
  }
}
